//@version=6
strategy(title="ICT Institutional Flow Scalper v3", shorttitle="ICT-SCALP", overlay=true, margin_long=100, margin_short=100, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=10000, commission_type=strategy.commission.cash_per_contract, commission_value=2.0, slippage=1)

grp_sess = "Sessions"
i_london  = input.bool(true, "London (2-5 AM ET)",       group=grp_sess)
i_ny_am   = input.bool(true, "NY AM (9:30-11 AM ET)",    group=grp_sess)
i_ny_pm   = input.bool(true, "NY PM (1:30-4 PM ET)",     group=grp_sess)
i_silver  = input.bool(true, "Silver Bullet (10-10:30)", group=grp_sess)
i_overnight = input.bool(true, "Overnight (11PM-2AM ET)",group=grp_sess)
i_max_trades = input.int(3, "Max Trades Per Day", minval=1, maxval=6, group=grp_sess)
i_no_nfp  = input.bool(true, "Avoid NFP Week Wed-Fri",   group=grp_sess)

grp_risk = "Risk Management"
i_sl_pts   = input.float(10.0, "Stop Loss (points)",      minval=5, maxval=15, step=0.5, group=grp_risk)
i_be_pts   = input.float(8.0,  "Break-Even trigger (pts)",minval=3, maxval=12, step=0.5, group=grp_risk)
i_max_loss = input.float(30.0, "Max Daily Loss (points)", minval=10, maxval=100, step=5.0, group=grp_risk)

grp_of = "Order Flow"
i_htf      = input.timeframe("15", "HTF Timeframe",       group=grp_of)
i_of_bars  = input.int(8,  "Structure Lookback Bars",     minval=3, maxval=20,  group=grp_of)
i_disp     = input.float(1.2, "Displacement xATR",        minval=0.8, maxval=3.0, step=0.1, group=grp_of)

grp_liq = "Liquidity"
i_liq_bars  = input.int(40,  "Institutional Liq Lookback",minval=15, maxval=100, group=grp_liq)
i_liq_min   = input.int(2,   "Min Level Touches",         minval=2, maxval=5,    group=grp_liq)
i_liq_tol   = input.float(0.04, "Touch Tolerance %",      minval=0.01, maxval=0.15, step=0.01, group=grp_liq)
i_sweep_atr = input.float(0.3,  "Min Sweep Size xATR",    minval=0.1, maxval=1.0,  step=0.1,  group=grp_liq)

grp_fvg = "FVG Settings"
i_fvg_atr   = input.float(0.4, "Min FVG Size xATR",       minval=0.2, maxval=1.5, step=0.1, group=grp_fvg)
i_fvg_expiry = input.int(20,   "FVG Valid for N bars",     minval=5, maxval=50,    group=grp_fvg)

grp_conf = "Confluence"
i_min_conf  = input.int(4, "Min Score to Trade (max 7)", minval=3, maxval=7, group=grp_conf)

grp_viz = "Visuals"
i_fvg_box   = input.bool(true,  "Show FVG Boxes",          group=grp_viz)
i_ob_box    = input.bool(true,  "Show Order Block Boxes",   group=grp_viz)
i_liq_lines = input.bool(true,  "Show Liquidity Lines",     group=grp_viz)
i_tpsl_vis  = input.bool(true,  "Show TP/SL on Chart",      group=grp_viz)
i_conf_lbl  = input.bool(true,  "Show Confluence Label",    group=grp_viz)
i_macro_bg  = input.bool(true,  "Session Backgrounds",      group=grp_viz)
i_dashboard = input.bool(true,  "Show Dashboard",           group=grp_viz)

tz         = "America/New_York"
et_hour    = hour(time, tz)
et_min     = minute(time, tz)
et_time    = et_hour * 100 + et_min
et_mins    = et_hour * 60 + et_min

in_london    = i_london    and et_time >= 200  and et_time < 500
in_ny_am     = i_ny_am     and et_time >= 930  and et_time < 1100
in_ny_pm     = i_ny_pm     and et_time >= 1330 and et_time < 1600
in_silver    = i_silver    and et_time >= 1000 and et_time < 1030
in_overnight = i_overnight and (et_time >= 2300 or et_time < 200)
in_macro1    = et_time >= 950  and et_time < 1010
in_macro2    = et_time >= 1100 and et_time < 1130
in_macro3    = et_time >= 1330 and et_time < 1400
in_macro4    = et_time >= 1515 and et_time < 1545
in_any_macro = in_macro1 or in_macro2 or in_macro3 or in_macro4
in_session   = in_london or in_ny_am or in_ny_pm or in_overnight

is_930   = et_time == 930
is_in_or = et_time >= 930 and et_time < 1000

is_nfp_week() =>
    d   = dayofmonth(time)
    dow = dayofweek(time)
    d <= 7 and dow >= 5

nfp_block = i_no_nfp and is_nfp_week()
can_trade  = in_session and not nfp_block

var int   trades_today = 0
var int   last_day     = 0
var float daily_loss   = 0.0
cur_day = dayofmonth(time)
if cur_day != last_day
    trades_today := 0
    daily_loss   := 0.0
    last_day     := cur_day

at_max      = trades_today >= i_max_trades
loss_limit  = daily_loss >= i_max_loss
can_enter   = can_trade and not at_max and not loss_limit and strategy.opentrades == 0

atr = ta.atr(14)

htf_h = request.security(syminfo.tickerid, i_htf, high,  lookahead=barmerge.lookahead_off)
htf_l = request.security(syminfo.tickerid, i_htf, low,   lookahead=barmerge.lookahead_off)
htf_c = request.security(syminfo.tickerid, i_htf, close, lookahead=barmerge.lookahead_off)
htf_o = request.security(syminfo.tickerid, i_htf, open,  lookahead=barmerge.lookahead_off)

htf_hh = htf_h > ta.highest(htf_h[1], i_of_bars)
htf_ll = htf_l < ta.lowest(htf_l[1],  i_of_bars)

var int htf_bias = 0
if htf_hh and htf_c > htf_o
    htf_bias := 1
if htf_ll and htf_c < htf_o
    htf_bias := -1

ltf_hh = high > ta.highest(high[1], i_of_bars) and close > open
ltf_ll = low  < ta.lowest(low[1],   i_of_bars) and close < open

var int ltf_bias = 0
if ltf_hh
    ltf_bias := 1
if ltf_ll
    ltf_bias := -1

bull_flow = htf_bias == 1 and ltf_bias == 1
bear_flow = htf_bias == -1 and ltf_bias == -1

bull_disp = (close - open) > atr * i_disp and close > close[1] and close > open
bear_disp = (open - close) > atr * i_disp and close < close[1] and close < open

liq_tol_pts = close * (i_liq_tol / 100)

f_touches_hi(lvl) =>
    n = 0
    for i = 1 to i_liq_bars
        if math.abs(high[i] - lvl) <= liq_tol_pts
            n += 1
    n

f_touches_lo(lvl) =>
    n = 0
    for i = 1 to i_liq_bars
        if math.abs(low[i] - lvl) <= liq_tol_pts
            n += 1
    n

bsl = ta.highest(high, i_liq_bars)
bsl_n = f_touches_hi(bsl)
bsl_valid = bsl_n >= i_liq_min

ssl = ta.lowest(low, i_liq_bars)
ssl_n = f_touches_lo(ssl)
ssl_valid = ssl_n >= i_liq_min

bsl_swept = high > bsl[1] and close < bsl[1] and (high - bsl[1]) > atr * i_sweep_atr and bsl_valid[1]
ssl_swept = low  < ssl[1] and close > ssl[1] and (ssl[1] - low)  > atr * i_sweep_atr and ssl_valid[1]

var bool last_sweep_bull = false
var bool last_sweep_bear = false
if ssl_swept
    last_sweep_bull := true
    last_sweep_bear := false
if bsl_swept
    last_sweep_bull := false
    last_sweep_bear := true

bull_fvg_raw = low > high[2] and (low - high[2]) > atr * i_fvg_atr
bear_fvg_raw = high < low[2] and (low[2] - high) > atr * i_fvg_atr

var float bfvg_top  = na
var float bfvg_bot  = na
var float bfvg_mid  = na
var int   bfvg_age  = 0
var float nfvg_top  = na
var float nfvg_bot  = na
var float nfvg_mid  = na
var int   nfvg_age  = 0

if bull_fvg_raw and bull_flow
    bfvg_top := low
    bfvg_bot := high[2]
    bfvg_mid := (bfvg_top + bfvg_bot) / 2
    bfvg_age := 0
else
    bfvg_age := bfvg_age + 1

if bear_fvg_raw and bear_flow
    nfvg_top := low[2]
    nfvg_bot := high
    nfvg_mid := (nfvg_top + nfvg_bot) / 2
    nfvg_age := 0
else
    nfvg_age := nfvg_age + 1

bfvg_active  = not na(bfvg_bot) and bfvg_age <= i_fvg_expiry
nfvg_active  = not na(nfvg_bot) and nfvg_age <= i_fvg_expiry
bfvg_retest  = bfvg_active and close >= bfvg_bot and close <= bfvg_top
nfvg_retest  = nfvg_active and close >= nfvg_bot and close <= nfvg_top

bull_ob_raw = close[1] < open[1] and bull_disp and htf_bias == 1
bear_ob_raw = close[1] > open[1] and bear_disp and htf_bias == -1

var float bob_top = na
var float bob_bot = na
var float nob_top = na
var float nob_bot = na
var int   bob_age = 0
var int   nob_age = 0

if bull_ob_raw
    bob_top := high[1]
    bob_bot := low[1]
    bob_age := 0
else
    bob_age := bob_age + 1

if bear_ob_raw
    nob_top := high[1]
    nob_bot := low[1]
    nob_age := 0
else
    nob_age := nob_age + 1

bob_active = not na(bob_bot) and bob_age <= i_fvg_expiry
nob_active = not na(nob_bot) and nob_age <= i_fvg_expiry
bob_retest = bob_active and close >= bob_bot and close <= bob_top
nob_retest = nob_active and close <= nob_top and close >= nob_bot

var float or_hi = na
var float or_lo = na
var float or_mid = na
var bool  or_done = false

if is_930
    or_hi   := high
    or_lo   := low
    or_done := false

if is_in_or and not is_930
    or_hi := math.max(or_hi, high)
    or_lo := math.min(or_lo, low)

if et_time == 1000 and not or_done
    or_mid  := (or_hi + or_lo) / 2
    or_done := true

var float prev_settle = na
var float org_hi  = na
var float org_lo  = na
var float org_mid = na

if et_time == 1614
    prev_settle := close

if is_930 and not na(prev_settle)
    org_hi  := math.max(open, prev_settle)
    org_lo  := math.min(open, prev_settle)
    org_mid := (org_hi + org_lo) / 2

in_discount = not na(org_mid) and close < org_mid
in_premium  = not na(org_mid) and close > org_mid

var float nwog_hi  = na
var float nwog_lo  = na
var float nwog_mid = na

if (dayofweek(time) == dayofweek.sunday and et_time >= 1800) or (dayofweek(time) == dayofweek.monday and et_time == 0)
    nwog_hi  := high
    nwog_lo  := low
    nwog_mid := (nwog_hi + nwog_lo) / 2

var float kam     = na
var bool  kam_bull = false
var bool  kam_bear = false
var float o930    = na

if is_930
    o930 := open

if et_time == 1000
    kam      := open
    kam_bull := not na(o930) and open < o930
    kam_bear := not na(o930) and open > o930

var bool kam_bull_wick = false
var bool kam_bear_wick = false

if et_time >= 1000 and et_time < 1030
    kam_bull_wick := kam_bull and (kam - low)  >= atr * 0.8 and htf_bias == 1
    kam_bear_wick := kam_bear and (high - kam) >= atr * 0.8 and htf_bias == -1

kam_bull_rt = kam_bull_wick and not na(kam) and math.abs(close - kam) <= atr * 0.3
kam_bear_rt = kam_bear_wick and not na(kam) and math.abs(close - kam) <= atr * 0.3

var bool judas_bull = false
var bool judas_bear = false

if is_in_or
    if high > high[1] and close < open and close < high[1] and (high - high[1]) > atr * 0.4
        judas_bear := true
        judas_bull := false
    if low < low[1] and close > open and close > low[1] and (low[1] - low) > atr * 0.4
        judas_bull := true
        judas_bear := false

c_range   = high - low
c_overlap = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
ovlp_pct  = c_range > 0 ? c_overlap / c_range : 0.5
is_lrlr   = ovlp_pct < 0.35
is_hrlr   = ovlp_pct > 0.65
sl_mult   = 1.0

bsl_target_bull = bsl > close + (atr * 0.5) ? bsl : close + (atr * 3.0)
ssl_target_bear = ssl < close - (atr * 0.5) ? ssl : close - (atr * 3.0)

tp1_bull = close + i_sl_pts * 1.5
tp2_bull = bsl_target_bull
sl_bull  = close - i_sl_pts

tp1_bear = close - i_sl_pts * 1.5
tp2_bear = ssl_target_bear
sl_bear  = close + i_sl_pts

rr_bull_ok = (tp2_bull - close) / i_sl_pts >= 2.0
rr_bear_ok = (close - tp2_bear) / i_sl_pts >= 2.0

sc_l1 = bull_flow
sc_l2 = last_sweep_bull
sc_l3 = in_discount
sc_l4 = bfvg_retest or bob_retest
sc_l5 = kam_bull_rt or judas_bull
sc_l6 = is_lrlr
sc_l7 = bull_disp

bull_score = (sc_l1 ? 1 : 0) + (sc_l2 ? 1 : 0) + (sc_l3 ? 1 : 0) + (sc_l4 ? 1 : 0) + (sc_l5 ? 1 : 0) + (sc_l6 ? 1 : 0) + (sc_l7 ? 1 : 0)

sc_s1 = bear_flow
sc_s2 = last_sweep_bear
sc_s3 = in_premium
sc_s4 = nfvg_retest or nob_retest
sc_s5 = kam_bear_rt or judas_bear
sc_s6 = is_lrlr
sc_s7 = bear_disp

bear_score = (sc_s1 ? 1 : 0) + (sc_s2 ? 1 : 0) + (sc_s3 ? 1 : 0) + (sc_s4 ? 1 : 0) + (sc_s5 ? 1 : 0) + (sc_s6 ? 1 : 0) + (sc_s7 ? 1 : 0)

long_sig  = bull_score >= i_min_conf and can_enter and rr_bull_ok
short_sig = bear_score >= i_min_conf and can_enter and rr_bear_ok

sl_pts = i_sl_pts * sl_mult

if long_sig
    strategy.entry("Long", strategy.long, comment="L" + str.tostring(bull_score) + "/7")
    strategy.exit("L-TP1", "Long", qty_percent=50, profit=i_sl_pts * 1.5, loss=sl_pts, comment="TP1")
    strategy.exit("L-TP2", "Long",                 profit=tp2_bull - close, loss=sl_pts, comment="TP2-LIQ")
    trades_today += 1

if short_sig
    strategy.entry("Short", strategy.short, comment="S" + str.tostring(bear_score) + "/7")
    strategy.exit("S-TP1", "Short", qty_percent=50, profit=i_sl_pts * 1.5, loss=sl_pts, comment="TP1")
    strategy.exit("S-TP2", "Short",                 profit=close - tp2_bear, loss=sl_pts, comment="TP2-LIQ")
    trades_today += 1

if strategy.position_size > 0 and close >= strategy.position_avg_price + i_be_pts
    strategy.exit("L-BE", "Long",  stop=strategy.position_avg_price + 0.5)
if strategy.position_size < 0 and close <= strategy.position_avg_price - i_be_pts
    strategy.exit("S-BE", "Short", stop=strategy.position_avg_price - 0.5)

if strategy.closedtrades > 0
    last_trade_profit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if last_trade_profit < 0
        daily_loss += math.abs(last_trade_profit)

if long_sig and i_tpsl_vis
    line.new(bar_index, close,    bar_index + 50, close,    color=color.new(color.white,  10), width=1, style=line.style_dotted)
    line.new(bar_index, tp1_bull, bar_index + 50, tp1_bull, color=color.new(color.lime,    0), width=1, style=line.style_dashed)
    line.new(bar_index, tp2_bull, bar_index + 50, tp2_bull, color=color.new(color.lime,    0), width=2, style=line.style_solid)
    line.new(bar_index, sl_bull,  bar_index + 50, sl_bull,  color=color.new(color.red,     0), width=2, style=line.style_solid)
    label.new(bar_index + 3, tp1_bull, "TP1  +" + str.tostring(math.round(tp1_bull - close, 1)) + "pts", color=color.new(color.lime,  75), textcolor=color.lime,  size=size.small, style=label.style_label_left)
    label.new(bar_index + 3, tp2_bull, "TP2  +" + str.tostring(math.round(tp2_bull - close, 1)) + "pts  INST LIQ", color=color.new(color.green, 75), textcolor=color.green, size=size.small, style=label.style_label_left)
    label.new(bar_index + 3, sl_bull,  "SL   -" + str.tostring(math.round(close - sl_bull, 1))  + "pts", color=color.new(color.red,   75), textcolor=color.red,   size=size.small, style=label.style_label_left)
    label.new(bar_index,     close,    "ENTRY  " + str.tostring(math.round(close, 2)),                    color=color.new(color.white, 75), textcolor=color.white, size=size.small, style=label.style_label_right)

if short_sig and i_tpsl_vis
    line.new(bar_index, close,    bar_index + 50, close,    color=color.new(color.white,  10), width=1, style=line.style_dotted)
    line.new(bar_index, tp1_bear, bar_index + 50, tp1_bear, color=color.new(color.lime,    0), width=1, style=line.style_dashed)
    line.new(bar_index, tp2_bear, bar_index + 50, tp2_bear, color=color.new(color.lime,    0), width=2, style=line.style_solid)
    line.new(bar_index, sl_bear,  bar_index + 50, sl_bear,  color=color.new(color.red,     0), width=2, style=line.style_solid)
    label.new(bar_index + 3, tp1_bear, "TP1  +" + str.tostring(math.round(close - tp1_bear, 1)) + "pts", color=color.new(color.lime,  75), textcolor=color.lime,  size=size.small, style=label.style_label_left)
    label.new(bar_index + 3, tp2_bear, "TP2  +" + str.tostring(math.round(close - tp2_bear, 1)) + "pts  INST LIQ", color=color.new(color.green, 75), textcolor=color.green, size=size.small, style=label.style_label_left)
    label.new(bar_index + 3, sl_bear,  "SL   -" + str.tostring(math.round(sl_bear - close, 1))  + "pts", color=color.new(color.red,   75), textcolor=color.red,   size=size.small, style=label.style_label_left)
    label.new(bar_index,     close,    "ENTRY  " + str.tostring(math.round(close, 2)),                    color=color.new(color.white, 75), textcolor=color.white, size=size.small, style=label.style_label_right)

alertcondition(long_sig,    title="LONG ENTRY",      message="LONG | {{ticker}} | {{interval}} | Entry: {{close}}")
alertcondition(short_sig,   title="SHORT ENTRY",     message="SHORT | {{ticker}} | {{interval}} | Entry: {{close}}")
alertcondition(ssl_swept,   title="SSL SWEPT",       message="SELL SIDE LIQ SWEPT | {{ticker}} | {{close}} | Watch for LONG")
alertcondition(bsl_swept,   title="BSL SWEPT",       message="BUY SIDE LIQ SWEPT  | {{ticker}} | {{close}} | Watch for SHORT")
alertcondition(bull_disp,   title="Bull Disp",       message="BULL DISPLACEMENT | {{ticker}} | {{close}}")
alertcondition(bear_disp,   title="Bear Disp",       message="BEAR DISPLACEMENT | {{ticker}} | {{close}}")
alertcondition(bfvg_retest, title="Bull FVG Retest", message="BULL FVG RETEST | {{ticker}} | {{close}}")
alertcondition(nfvg_retest, title="Bear FVG Retest", message="BEAR FVG RETEST | {{ticker}} | {{close}}")
alertcondition(judas_bull,  title="Judas Bull",      message="JUDAS BULL SWEEP | {{ticker}} | Low swept - expect UP")
alertcondition(judas_bear,  title="Judas Bear",      message="JUDAS BEAR SWEEP | {{ticker}} | High swept - expect DOWN")
alertcondition(in_macro1 and not in_macro1[1], title="Macro 9:50", message="MACRO 9:50 OPEN | {{ticker}}")

if i_fvg_box
    if bull_fvg_raw and bull_flow
        box.new(bar_index - 1, bfvg_top, bar_index + 30, bfvg_bot, bgcolor=color.new(color.lime, 88), border_color=color.new(color.lime, 40), border_width=1, text="FVG", text_color=color.new(color.lime, 30), text_size=size.tiny)
    if bear_fvg_raw and bear_flow
        box.new(bar_index - 1, nfvg_top, bar_index + 30, nfvg_bot, bgcolor=color.new(color.red,  88), border_color=color.new(color.red,  40), border_width=1, text="FVG", text_color=color.new(color.red,  30), text_size=size.tiny)

if i_ob_box
    if bull_ob_raw
        box.new(bar_index - 1, bob_top, bar_index + 25, bob_bot, bgcolor=color.new(color.aqua,   88), border_color=color.new(color.aqua,   30), border_width=1, text="OB", text_color=color.aqua,   text_size=size.tiny)
    if bear_ob_raw
        box.new(bar_index - 1, nob_top, bar_index + 25, nob_bot, bgcolor=color.new(color.orange, 88), border_color=color.new(color.orange, 30), border_width=1, text="OB", text_color=color.orange, text_size=size.tiny)

if i_liq_lines
    if bsl_swept
        line.new(bar_index - 15, bsl[1], bar_index + 5, bsl[1], color=color.new(color.yellow, 0), width=2, style=line.style_solid)
        label.new(bar_index - 15, bsl[1], "BSL SWEPT (" + str.tostring(bsl_n[1]) + "x)", color=color.new(color.yellow, 70), textcolor=color.yellow, style=label.style_label_right, size=size.small)
    if ssl_swept
        line.new(bar_index - 15, ssl[1], bar_index + 5, ssl[1], color=color.new(color.yellow, 0), width=2, style=line.style_solid)
        label.new(bar_index - 15, ssl[1], "SSL SWEPT (" + str.tostring(ssl_n[1]) + "x)", color=color.new(color.yellow, 70), textcolor=color.yellow, style=label.style_label_right, size=size.small)

plot(or_done  ? or_hi  : na, "OR Hi",   color.new(color.yellow, 20), 1, plot.style_linebr)
plot(or_done  ? or_lo  : na, "OR Lo",   color.new(color.yellow, 20), 1, plot.style_linebr)
plot(or_done  ? or_mid : na, "OR Mid",  color.new(color.yellow, 55), 1, plot.style_linebr)
plot(not na(org_hi)  ? org_hi  : na, "ORG Hi",  color.new(color.blue, 25), 1, plot.style_linebr)
plot(not na(org_lo)  ? org_lo  : na, "ORG Lo",  color.new(color.blue, 25), 1, plot.style_linebr)
plot(not na(org_mid) ? org_mid : na, "ORG Mid", color.new(color.blue, 50), 1, plot.style_linebr)
plot(not na(nwog_hi)  ? nwog_hi  : na, "NWOG Hi",  color.new(color.purple, 20), 1, plot.style_linebr)
plot(not na(nwog_lo)  ? nwog_lo  : na, "NWOG Lo",  color.new(color.purple, 20), 1, plot.style_linebr)
plot(not na(nwog_mid) ? nwog_mid : na, "NWOG Mid", color.new(color.purple, 50), 1, plot.style_linebr)
plot(not na(kam) ? kam : na, "10AM", color.new(color.fuchsia, 0), 2, plot.style_linebr)

plotshape(long_sig,   "LONG",  shape.labelup,      location.belowbar, color.new(color.lime,   0), text="LONG",  textcolor=color.black,  size=size.large)
plotshape(short_sig,  "SHORT", shape.labeldown,    location.abovebar, color.new(color.red,    0), text="SHORT", textcolor=color.white,  size=size.large)
plotshape(ssl_swept,  "SSL",   shape.triangleup,   location.belowbar, color.new(color.yellow, 0), text="SSL",   textcolor=color.yellow, size=size.normal)
plotshape(bsl_swept,  "BSL",   shape.triangledown, location.abovebar, color.new(color.yellow, 0), text="BSL",   textcolor=color.yellow, size=size.normal)
plotshape(judas_bull, "JB",    shape.circle,       location.belowbar, color.new(color.orange, 15), size=size.small)
plotshape(judas_bear, "JB",    shape.circle,       location.abovebar, color.new(color.orange, 15), size=size.small)
plotshape(bull_disp,  "D+",    shape.triangleup,   location.belowbar, color.new(color.teal,   30), size=size.tiny)
plotshape(bear_disp,  "D-",    shape.triangledown, location.abovebar, color.new(color.teal,   30), size=size.tiny)

bgcolor(i_macro_bg and in_macro1  ? color.new(color.teal,   93) : na, title="Macro 9:50")
bgcolor(i_macro_bg and in_macro2  ? color.new(color.teal,   93) : na, title="Macro 11")
bgcolor(i_macro_bg and in_macro3  ? color.new(color.teal,   93) : na, title="Macro 1:30")
bgcolor(i_macro_bg and in_macro4  ? color.new(color.teal,   93) : na, title="Macro 3:15")
bgcolor(i_macro_bg and in_silver  ? color.new(color.purple, 90) : na, title="Silver Bullet")
bgcolor(i_macro_bg and in_london  ? color.new(color.blue,   96) : na, title="London")
bgcolor(i_macro_bg and in_ny_am   ? color.new(color.green,  97) : na, title="NY AM")
bgcolor(i_macro_bg and in_ny_pm   ? color.new(color.green,  98) : na, title="NY PM")

if i_conf_lbl and barstate.islast
    b_col  = bull_score >= 6 ? color.lime : bull_score >= i_min_conf ? color.yellow : color.new(color.gray, 40)
    n_col  = bear_score >= 6 ? color.red  : bear_score >= i_min_conf ? color.orange : color.new(color.gray, 40)
    bg_col = bull_score >= i_min_conf ? color.new(color.lime, 65) : bear_score >= i_min_conf ? color.new(color.red, 65) : color.new(color.gray, 75)
    txt    = "BULL " + str.tostring(bull_score) + "/7\nBEAR " + str.tostring(bear_score) + "/7\nNEED " + str.tostring(i_min_conf) + "+ TO TRADE"
    label.new(bar_index + 3, high + atr * 2.5, txt, color=bg_col, textcolor=color.white, style=label.style_label_left, size=size.normal)

if i_dashboard and barstate.islast
    var table d = table.new(position.top_right, 2, 30, bgcolor=color.new(color.black, 8), border_width=1, border_color=color.new(color.gray, 55))
    G  = color.new(color.lime,   12)
    R  = color.new(color.red,    12)
    N  = color.new(color.gray,   58)
    W  = color.new(color.orange, 12)
    Y  = color.new(color.yellow, 12)
    NV = color.new(color.navy,   10)
    table.cell(d, 0, 0, "ICT SCALPER v3",  text_color=color.white,  bgcolor=NV, text_size=size.normal)
    table.cell(d, 1, 0, "5m  MNQ/MES",     text_color=color.yellow, bgcolor=NV, text_size=size.normal)
    s_str = in_london ? "LONDON" : in_ny_am ? "NY AM" : in_ny_pm ? "NY PM" : in_overnight ? "OVERNIGHT" : "CLOSED"
    table.cell(d, 0, 1, "Session",          text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 1, s_str,              text_color=color.white, bgcolor=in_session ? G : N, text_size=size.tiny)
    ct_str = can_enter ? "YES" : at_max ? "MAX TRADES" : loss_limit ? "LOSS LIMIT" : nfp_block ? "NFP BLOCK" : not in_session ? "NO SESSION" : "NO"
    table.cell(d, 0, 2, "Can Trade",        text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 2, ct_str,             text_color=color.white, bgcolor=can_enter ? G : R, text_size=size.tiny)
    table.cell(d, 0, 3, "Trades",           text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 3, str.tostring(trades_today) + " / " + str.tostring(i_max_trades), text_color=at_max ? color.red : color.lime, bgcolor=at_max ? W : N, text_size=size.tiny)
    h_str = htf_bias == 1 ? "BULLISH" : htf_bias == -1 ? "BEARISH" : "NEUTRAL"
    table.cell(d, 0, 4, "HTF 15m",          text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 4, h_str,              bgcolor=htf_bias == 1 ? G : htf_bias == -1 ? R : N, text_color=color.white, text_size=size.tiny)
    l_str = ltf_bias == 1 ? "BULLISH" : ltf_bias == -1 ? "BEARISH" : "NEUTRAL"
    table.cell(d, 0, 5, "LTF 5m",           text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 5, l_str,              bgcolor=ltf_bias == 1 ? G : ltf_bias == -1 ? R : N, text_color=color.white, text_size=size.tiny)
    of_str = bull_flow ? "BULL ALIGNED" : bear_flow ? "BEAR ALIGNED" : "WAITING"
    table.cell(d, 0, 6, "OF Aligned",       text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 6, of_str,             bgcolor=bull_flow ? G : bear_flow ? R : W, text_color=color.white, text_size=size.tiny)
    mkt_str = is_lrlr ? "LRLR  CLEAN" : is_hrlr ? "HRLR  CHOPPY" : "NORMAL"
    table.cell(d, 0, 7, "Mkt Cond",         text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 7, mkt_str,            bgcolor=is_lrlr ? G : is_hrlr ? R : N, text_color=color.white, text_size=size.tiny)
    pz_str = in_discount ? "DISCOUNT" : in_premium ? "PREMIUM" : "MID"
    table.cell(d, 0, 8, "Price Zone",       text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 8, pz_str,             bgcolor=in_discount ? G : in_premium ? R : N, text_color=color.white, text_size=size.tiny)
    table.cell(d, 0, 9,  "BSL Level",       text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 9,  str.tostring(math.round(bsl, 2)) + "  (" + str.tostring(bsl_n) + "x)", text_color=bsl_valid ? color.yellow : color.gray, bgcolor=N, text_size=size.tiny)
    table.cell(d, 0, 10, "SSL Level",       text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 10, str.tostring(math.round(ssl, 2)) + "  (" + str.tostring(ssl_n) + "x)", text_color=ssl_valid ? color.yellow : color.gray, bgcolor=N, text_size=size.tiny)
    sw_str = last_sweep_bull ? "SSL SWEPT BULL" : last_sweep_bear ? "BSL SWEPT BEAR" : "NONE"
    table.cell(d, 0, 11, "Last Sweep",      text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 11, sw_str,            bgcolor=last_sweep_bull ? G : last_sweep_bear ? R : N, text_color=color.white, text_size=size.tiny)
    table.cell(d, 0, 12, "ORG Mid",         text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 12, na(org_mid) ? "--" : str.tostring(math.round(org_mid, 2)), text_color=color.yellow, bgcolor=N, text_size=size.tiny)
    table.cell(d, 0, 13, "NWOG Mid",        text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 13, na(nwog_mid) ? "--" : str.tostring(math.round(nwog_mid, 2)), text_color=color.purple, bgcolor=N, text_size=size.tiny)
    table.cell(d, 0, 14, "10AM Open",       text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 14, na(kam) ? "--" : str.tostring(math.round(kam, 2)), text_color=color.fuchsia, bgcolor=N, text_size=size.tiny)
    ks_str = kam_bull_wick ? "BULL WICK" : kam_bear_wick ? "BEAR WICK" : "WAITING"
    table.cell(d, 0, 15, "10AM Setup",      text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 15, ks_str,            bgcolor=kam_bull_wick ? G : kam_bear_wick ? R : N, text_color=color.white, text_size=size.tiny)
    j_str = judas_bull ? "BULL SWEEP" : judas_bear ? "BEAR SWEEP" : "--"
    table.cell(d, 0, 16, "Judas",           text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 16, j_str,             bgcolor=judas_bull ? G : judas_bear ? R : N, text_color=color.white, text_size=size.tiny)
    fvg_str = bfvg_retest ? "BULL RETEST" : nfvg_retest ? "BEAR RETEST" : bull_fvg_raw ? "BULL FORMED" : bear_fvg_raw ? "BEAR FORMED" : "--"
    table.cell(d, 0, 17, "FVG",             text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 17, fvg_str,           bgcolor=bfvg_retest or bull_fvg_raw ? G : nfvg_retest or bear_fvg_raw ? R : N, text_color=color.white, text_size=size.tiny)
    ob_str = bob_retest ? "BULL OB" : nob_retest ? "BEAR OB" : "--"
    table.cell(d, 0, 18, "Order Block",     text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 18, ob_str,            bgcolor=bob_retest ? G : nob_retest ? R : N, text_color=color.white, text_size=size.tiny)
    b_col2 = bull_score >= 6 ? G : bull_score >= i_min_conf ? Y : N
    n_col2 = bear_score >= 6 ? R : bear_score >= i_min_conf ? W : N
    table.cell(d, 0, 19, "BULL SCORE",      text_color=color.white, text_size=size.small)
    table.cell(d, 1, 19, str.tostring(bull_score) + " / 7", text_color=color.white, bgcolor=b_col2, text_size=size.small)
    table.cell(d, 0, 20, "BEAR SCORE",      text_color=color.white, text_size=size.small)
    table.cell(d, 1, 20, str.tostring(bear_score) + " / 7", text_color=color.white, bgcolor=n_col2, text_size=size.small)
    table.cell(d, 0, 21, "NEED TO TRADE",   text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 21, str.tostring(i_min_conf) + "+ conditions", text_color=color.yellow, bgcolor=N, text_size=size.tiny)
    sig_str = long_sig ? "LONG  ENTRY" : short_sig ? "SHORT ENTRY" : at_max ? "MAX TRADES" : loss_limit ? "LOSS LIMIT HIT" : "SCANNING..."
    table.cell(d, 0, 22, "SIGNAL",          text_color=color.white, text_size=size.small)
    table.cell(d, 1, 22, sig_str,           bgcolor=long_sig ? G : short_sig ? R : at_max ? W : N, text_color=color.white, text_size=size.small)
    table.cell(d, 0, 23, "Entry Price",     text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 23, str.tostring(math.round(close, 2)), text_color=color.white, bgcolor=N, text_size=size.tiny)
    tp1_show = long_sig ? str.tostring(math.round(tp1_bull, 2)) + "  (+" + str.tostring(math.round(tp1_bull - close, 1)) + ")" : short_sig ? str.tostring(math.round(tp1_bear, 2)) + "  (+" + str.tostring(math.round(close - tp1_bear, 1)) + ")" : "--"
    table.cell(d, 0, 24, "TP1  Scalp",      text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 24, tp1_show,          text_color=color.lime, bgcolor=N, text_size=size.tiny)
    tp2_show = long_sig ? str.tostring(math.round(tp2_bull, 2)) + "  (+" + str.tostring(math.round(tp2_bull - close, 1)) + ")" : short_sig ? str.tostring(math.round(tp2_bear, 2)) + "  (+" + str.tostring(math.round(close - tp2_bear, 1)) + ")" : "--"
    table.cell(d, 0, 25, "TP2  Liq Run",    text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 25, tp2_show,          text_color=color.lime, bgcolor=N, text_size=size.tiny)
    sl_show = long_sig ? str.tostring(math.round(sl_bull, 2)) + "  (-" + str.tostring(math.round(close - sl_bull, 1)) + ")" : short_sig ? str.tostring(math.round(sl_bear, 2)) + "  (-" + str.tostring(math.round(sl_bear - close, 1)) + ")" : "--"
    table.cell(d, 0, 26, "Stop Loss",       text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 26, sl_show,           text_color=color.red, bgcolor=N, text_size=size.tiny)
    pnl = strategy.netprofit
    wr  = strategy.closedtrades > 0 ? math.round(strategy.wintrades / strategy.closedtrades * 100, 1) : 0.0
    pf  = strategy.grossloss != 0   ? math.round(strategy.grossprofit / math.abs(strategy.grossloss), 2) : 0.0
    table.cell(d, 0, 27, "Net PnL",         text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 27, "$" + str.tostring(math.round(pnl, 2)), text_color=pnl >= 0 ? color.lime : color.red, bgcolor=N, text_size=size.tiny)
    table.cell(d, 0, 28, "Win Rate",        text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 28, str.tostring(wr) + "%  /  " + str.tostring(strategy.closedtrades) + " trades", text_color=wr >= 50 ? color.lime : color.red, bgcolor=N, text_size=size.tiny)
    table.cell(d, 0, 29, "Profit Factor",   text_color=color.white, text_size=size.tiny)
    table.cell(d, 1, 29, str.tostring(pf),  text_color=pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, bgcolor=N, text_size=size.tiny)
